{
  "manifest_version": 3,
  "name": "Simple Dark Mode for Hacker News",
  "short_name": "HN Dark Mode",
  "description": "A clean, easy-on-the-eyes dark mode for Hacker News. Click the icon to switch Dark / System / Light. Unofficial.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dark Mode for HN: Dark (click for System)",
    "default_icon": {
      "16": "icons/dark16.png",
      "32": "icons/dark32.png",
      "48": "icons/dark48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://news.ycombinator.com/*"],
  "content_scripts": [
    {
      "matches": ["https://news.ycombinator.com/*"],
      "css": ["dark.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
